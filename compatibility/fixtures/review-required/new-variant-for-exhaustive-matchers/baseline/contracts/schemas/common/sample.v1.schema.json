{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-business:contracts:common:sample:v1",
  "title": "Sample",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "pattern": "^ref_[a-z0-9]{4,32}$",
      "examples": [
        "ref_a1b2c3d4",
        "ref_zz99"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "settled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "note": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "standard"
      ]
    }
  },
  "required": [
    "reference",
    "status"
  ],
  "additionalProperties": true
}
